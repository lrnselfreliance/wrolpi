    "ssh": "user@192.0.2.10",
    "ssh_opts": [],
    "restart": "docker restart wrolpi-api-1",
    "drop_caches": "sudo -n sh -c \"sync; echo 3 > /proc/sys/vm/drop_caches\""
  },
