[Unit]
Description=WROLPi torrents (qBittorrent, inside the VPN's network namespace)
PartOf=wrolpi.target
# Torrents have no network but the VPN's; they stop and start with it.
BindsTo=wrolpi-vpn.service
After=wrolpi-vpn.service wrolpi-mounts.service

[Service]
NetworkNamespacePath=/run/netns/wrolpi-vpn
# The namespace's resolv.conf (the VPN's DNS servers); `ip netns exec` would bind it, systemd does not.
BindReadOnlyPaths=/etc/netns/wrolpi-vpn/resolv.conf:/etc/resolv.conf
ExecStartPre=/usr/bin/python3 /opt/wrolpi/modules/torrents/qbittorrent_prepare.py --profile /var/lib/wrolpi-torrent --allow 10.211.0.1/32
ExecStart=/usr/bin/qbittorrent-nox --confirm-legal-notice --profile=/var/lib/wrolpi-torrent
User=wrolpi
Group=wrolpi
# qBittorrent's own state, outside the library.  A new one re-adds every torrent from config/torrents/.
StateDirectory=wrolpi-torrent
Environment=HOME=/var/lib/wrolpi-torrent
# qBittorrent writes only to the library, never WROLPi's config, whatever a torrent or its WebUI asks for.
ProtectSystem=strict
ReadWritePaths=/media/wrolpi
ReadOnlyPaths=/media/wrolpi/config
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
Restart=on-failure
RestartSec=10
# Below everything a person is waiting on.
Nice=10

[Install]
WantedBy=default.target
